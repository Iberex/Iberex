---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import Bi from '../components/Bi.astro';
import { site } from '../data/site';
import '../styles/page.css';
import '../styles/about.css';

// CV-link enkel tonen als het bestand echt in public/ staat
const hasCv = !!site.cv && fs.existsSync(path.join(process.cwd(), 'public', site.cv));
const socials = site.socials.filter(s => s.href);
// 'x' (of iets met een x erin, zoals "Open for an internship, x") = nog in te vullen → gedimd tonen
const isTodo = (s: string) => s.trim() === 'x' || /(^|[\s,])x$/.test(s.trim());

const facts = [
  { en: 'Name', nl: 'Naam', value: site.name },
  { en: 'Based in', nl: 'Woonplaats', value: site.basedIn },
  { en: 'Studying at', nl: 'Studeert aan', value: site.studyingAt },
  { en: 'Status', nl: 'Status', value: site.status },
];
---

<Layout title="About" bodyClass="is-page">
  <main class="case about">

    <!-- titel + portret -->
    <header class="about-hero">
      <h1 class="about-title"><Bi en="About" nl="Over mij" /></h1>
      {site.photo && (
        <figure class="about-photo reveal">
          <img class="media" src={site.photo} alt={`Portrait of ${site.name}`} loading="eager" decoding="async" />
        </figure>
      )}
    </header>

    <!-- feitenrij -->
    <dl class="about-facts">
      {facts.map(f => (
        <div>
          <dt><Bi en={f.en} nl={f.nl} /></dt>
          {typeof f.value === 'string'
            ? <dd class:list={{ todo: isTodo(f.value) }}>{f.value}</dd>
            : <dd class:list={{ todo: isTodo(f.value.en) }}><Bi en={f.value.en} nl={f.value.nl} /></dd>}
        </div>
      ))}
    </dl>

    <!-- intro -->
    <section class="about-row">
      <h2 class="about-label"><Bi en="Intro" nl="Intro" /></h2>
      <div>
        <p class:list={['about-intro', { todo: isTodo(site.intro.en) }]}><Bi en={site.intro.en} nl={site.intro.nl} /></p>
        {hasCv && (
          <a class="about-link" href={site.cv} download>
            <Bi en="Download CV" nl="Download CV" /> <span aria-hidden="true">↓</span>
          </a>
        )}
      </div>
    </section>

    <!-- wat ik doe en waarmee: per groep één blok grote woorden, gescheiden door schuine strepen;
         ze lichten op bij hover, zoals de titels in de trommel -->
    <section class="about-row">
      <h2 class="about-label"><Bi en="What I do" nl="Wat ik doe" /></h2>
      <div class="about-skills">
        {Object.entries(site.skills).map(([group, items]) => (
          <div class="about-skill-group">
            <h3 class="about-col-title">{group}</h3>
            <p class="about-wall">
              {items.map((item, i) => (
                <>
                  <span class:list={['about-word', { todo: isTodo(item) }]}>{item}</span>
                  {i < items.length - 1 && <span class="about-slash" aria-hidden="true"> / </span>}
                </>
              ))}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- opleiding & ervaring -->
    <section class="about-row">
      <h2 class="about-label"><Bi en="Education & experience" nl="Opleiding & ervaring" /></h2>
      <div class="about-timeline">
        {[
          { en: 'Education', nl: 'Opleiding', items: site.education },
          { en: 'Experience', nl: 'Ervaring', items: site.experience },
        ].map(col => (
          <div>
            <h3 class="about-col-title"><Bi en={col.en} nl={col.nl} /></h3>
            <ul>
              {col.items.map(e => (
                <li>
                  <p class="about-entry">
                    <strong class:list={{ todo: isTodo(e.name) }}>
                      {'href' in e && e.href
                        ? <a class="about-entry-link" href={e.href} target="_blank" rel="noopener">{e.name} <span aria-hidden="true">↗</span></a>
                        : e.name}
                    </strong>
                    <span class:list={['about-years', { todo: isTodo(e.years.en) }]}><Bi en={e.years.en} nl={e.years.nl} /></span>
                  </p>
                  <p class:list={['about-detail', { todo: isTodo(e.detail.en) }]}>
                    <Bi en={e.detail.en} nl={e.detail.nl} />
                  </p>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- contact -->
    <section class="about-contact" id="contact">
      <!-- de grote tekst zelf opent meteen een nieuwe mail -->
      <h2 class="about-talk">
        {isTodo(site.email)
          ? <Bi en="Let's talk" nl="Laten we praten" />
          : <a class="about-talk-link" href={`mailto:${site.email}`}><Bi en="Let's talk" nl="Laten we praten" /></a>}
      </h2>
      {isTodo(site.email)
        ? <p class="about-mail todo">x</p>
        : <a class="about-mail" href={`mailto:${site.email}`}>{site.email}</a>}
      {socials.length > 0 && (
        <p class="about-socials">
          {socials.map(s => <a class="about-link" href={s.href} target="_blank" rel="noopener">{s.label} <span aria-hidden="true">↗</span></a>)}
        </p>
      )}
    </section>
  </main>
</Layout>
